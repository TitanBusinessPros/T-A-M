rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /logos/{ownerId}/{logoId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == ownerId
                    && request.resource.size <= 500 * 1024
                    && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }
  }
}
